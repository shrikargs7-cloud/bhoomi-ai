# BhoomiAI Environment Variables (Copy to .env and customize for production)
BHOOMI_JWT_SECRET=replace-with-random-32-byte-secret
BHOOMI_DATABASE_URL=sqlite:///backend/data/bhoomiai.db
# For PostgreSQL via Docker Compose:
# BHOOMI_DATABASE_URL=postgresql+psycopg2://bhoomi:bhoomi@postgres:5432/bhoomiai

BHOOMI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BHOOMI_RATE_LIMIT_ENABLED=true
BHOOMI_RATE_LIMIT_RPM=60

# Optional external Vision-LLM API key (only used if user grants DPDP consent)
OPENAI_API_KEY=

# Frontend API URL
VITE_API_BASE=http://127.0.0.1:8000/api
